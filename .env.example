# ==========================================
# IncuBrix Distribution - Environment Config
# ==========================================

# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
APP_URL=http://localhost:4000

# Logging
LOG_LEVEL=info

# Database Paths
DB_PATH=./data/incubrix.db
STORAGE_DIR=./storage

# S3-compatible Object Storage (MinIO / AWS S3)
STORAGE_BACKEND=local
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=incubrix-artifacts
S3_PUBLIC_BASE_URL=http://localhost:9000/incubrix-artifacts

# Local Test Instances
GHOST_LOCAL_URL=http://localhost:2368
GHOST_URL=http://localhost:2368
GHOST_ADMIN_KEY=
  
LEMMY_LOCAL_URL=http://localhost:8536
LEMMY_JWT_TOKEN=
LEMMY_COMMUNITY_ID=1
POSTGRES_USER=lemmy
POSTGRES_PASSWORD=lemmy_db_password_123
POSTGRES_DB=lemmy

# Security & Secrets (Placeholders for local dev / tests)
WEBHOOK_SHARED_SECRET=incubrix_webhook_dev_secret_xyz123
CALLBACK_SIGNING_SECRET=incubrix_callback_secret_abc789
ADMIN_API_KEY=incubrix_admin_dev_token_2026
API_ACCESS_TOKEN=

# Operational Limits, Sweeper & Retries
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
DEFAULT_TIMEOUT_MS=5000
MAX_RETRIES=3
TEST_POST_TTL_S=600

# Recertification Scheduler & Alerts
RECERT_INTERVAL_MS=3600000
RECERT_BEFORE_DAYS=25
ALERT_WEBHOOK_URL=

# Simulation & Test Harness
SIMULATION_DEFAULT=true

# Local Mock Service URLs (embedded in app under /mock)
MOCK_DISCOURSE_URL=http://localhost:4000/mock/discourse
MOCK_LEMMY_URL=http://localhost:4000/mock/lemmy
MOCK_DEVTO_URL=http://localhost:4000/mock/devto
MOCK_GHOST_URL=http://localhost:4000/mock/ghost
MOCK_WEBHOOK_RECEIVER_URL=http://localhost:4000/mock/webhook

# AI Adapter & Rules Extraction (mock | openai | anthropic)
AI_ADAPTER_PROVIDER=mock
AI_ADAPTER_API_KEY=
RULES_AI_PROVIDER=mock
RULES_AI_MODEL=gpt-4o-mini
RULES_AI_API_KEY=
