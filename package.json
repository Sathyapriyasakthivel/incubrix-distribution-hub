{
  "name": "incubrix-distribution-network",
  "version": "1.0.0",
  "description": "IncuBrix Distribution — Long-Tail Destination Network Publishing Service",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
